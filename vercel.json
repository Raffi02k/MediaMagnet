{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "media-magnet-sandy.vercel.app" }],
      "destination": "https://www.mediamagnet.se/:path*",
      "permanent": true
    }
  ]
}

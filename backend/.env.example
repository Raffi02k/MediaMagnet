# Form provider: 'web3forms', 'crm', or 'smtp'
FORM_PROVIDER=web3forms

# Web3Forms API Key (skickar till projektets/kundens e-post)
WEB3FORMS_ACCESS_KEY=fa263251-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# MediaMagnet CRM (används när FORM_PROVIDER=crm)
CRM_API_URL=https://crm.mediamagnet.se/api/leads
CRM_API_KEY=
PROJECT_ID=mediamagnet

# Valfri direkt-SMTP (används när FORM_PROVIDER=smtp)
CONTACT_TO_EMAIL=mediamagnetse@gmail.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=webb@example.com
SMTP_USE_TLS=true

ENVIRONMENT=production

